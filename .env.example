# ADMIN_PASSWORD: Senha de administrador usada exclusivamente no backend para autorizar edição e exclusão.
# No Vercel, configure nas Environment Variables do projeto.
ADMIN_PASSWORD="socorro"

# Vercel KV / Upstash Redis (Opcional - para persistência global de dados na nuvem da Vercel)
# Se não preenchido, o backend utiliza persistência em arquivo JSON local com fallback de memória.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Porta do servidor local
PORT=3000

# GEMINI_API_KEY: Configurado caso utilize recursos de IA
GEMINI_API_KEY=""

# APP_URL: URL da aplicação
APP_URL=""
